---
layout: layouts/base.vto
---
<div class="mb-8 text-center">
  <h1 class="mb-2 font-mono text-3xl font-semibold tracking-tight">{{ repo }}</h1>
  <p class="m-0 text-sm text-ink-soft">
    <a class="text-ink-soft" href="https://github.com/{{ repo }}">github.com/{{ repo }}</a>
  </p>
</div>

<nav class="mb-8 flex justify-center gap-6 border-b border-rule">
  {{ for tab of tabs }}
  <a href="{{ tab.href }}" class="-mb-px border-b-2 px-1 pb-3 text-sm font-semibold {{ if tab.key == period }}border-accent text-ink{{ else }}border-transparent text-ink-soft hover:text-ink{{ /if }}">{{ tab.label }}</a>
  {{ /for }}
  <a href="/{{ repo }}/{{ period }}.rss" title="Subscribe to the {{ period }} RSS feed" aria-label="Subscribe to the {{ period }} RSS feed" class="-mb-px border-b-2 border-transparent px-1 pb-3 text-sm text-ink-soft hover:text-accent">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"></path></svg>
  </a>
</nav>

{{ if bucketLabel }}
<div class="mb-8 flex items-center justify-between gap-4">
  <h2 class="m-0 text-xl font-semibold tracking-tight">{{ bucketLabel }}</h2>
  <a class="shrink-0 text-sm font-semibold text-accent no-underline hover:underline" href="{{ topHref }}">← Recent</a>
</div>
{{ /if }}

{{ if feedPosts.length == 0 }}
<p class="text-center italic text-ink-soft">No {{ period }} summaries yet.</p>
{{ else }}
<div>
  {{ for post of feedPosts }}
  <article class="border-b border-rule py-10 first:pt-0 last:border-0">
    <p class="mb-2 flex items-center justify-center gap-x-2 text-xs font-semibold uppercase tracking-wider text-ink-soft">
      <span>{{ if post.period_label }}{{ post.period_label }}{{ else }}{{ post.date |> date('HUMAN_DATE') }}{{ /if }}{{ if post.commits }} · {{ post.commits }} commits{{ /if }}</span>
      {{ if post.authors }}
      <span class="flex items-center">
        <span class="flex -space-x-1.5">
          {{ for login of post.authors.slice(0, 5) }}
          <a href="https://github.com/{{ login }}" title="{{ login }}"><img class="h-5 w-5 rounded-full border border-white bg-surface" src="https://github.com/{{ login }}.png?size=24" alt="{{ login }}" loading="lazy" /></a>
          {{ /for }}
        </span>
        {{ if post.authors.length > 5 }}<span class="ml-1.5">+{{ post.authors.length - 5 }}</span>{{ /if }}
      </span>
      {{ /if }}
    </p>
    <h2 class="mb-2 text-3xl font-bold leading-tight tracking-tight"><a class="text-ink no-underline hover:text-accent" href="{{ post.url }}">{{ post.title }}</a></h2>
    {{ if post.excerpt }}<p class="mb-4 text-lg text-ink-soft">{{ post.excerpt }}</p>{{ /if }}
    <a class="text-sm font-semibold text-accent no-underline hover:underline" href="{{ post.url }}">Read the issue →</a>
  </article>
  {{ /for }}
</div>
{{ /if }}

{{ if archive.length }}
<section class="mt-14 border-t border-rule pt-8">
  <h2 class="mb-5 m-0 text-xs font-semibold uppercase tracking-wider text-ink-soft">Archive</h2>
  <ul class="m-0 flex flex-wrap gap-x-8 gap-y-3 p-0" style="list-style:none">
    {{ for item of archive }}
    <li>
      <a href="{{ item.url }}" class="text-sm no-underline hover:underline {{ if item.url == bucketUrl }}font-semibold text-ink{{ else }}text-accent{{ /if }}">{{ item.label }}<span class="font-normal text-ink-soft"> · {{ item.count }}</span></a>
    </li>
    {{ /for }}
  </ul>
</section>
{{ /if }}
