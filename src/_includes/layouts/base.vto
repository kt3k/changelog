<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if title }}{{ title }} — {{ site_name }}{{ else }}{{ site_name }}{{ /if }}</title>
  <meta name="description" content="{{ description || site_description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="site-title" href="/">{{ site_name }}</a>
      <a class="subscribe-btn" href="#subscribe">Subscribe</a>
    </div>
  </header>

  <main class="site-main">
    {{ content }}
  </main>

  <footer class="site-footer" id="subscribe">
    <h2 class="cta-title">Never miss an issue</h2>
    <p class="cta-text">Get the day's open-source highlights delivered to your inbox.</p>
    <form class="cta-form" onsubmit="return false">
      <input type="email" placeholder="you@example.com" aria-label="Email address" required>
      <button type="submit">Subscribe</button>
    </form>
    <p class="footer-meta">© {{ ("" + new Date().getFullYear()) }} {{ site_name }}. Built with Lume.</p>
  </footer>
</body>
</html>
