<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if title }}{{ title }} · {{ site_name }}{{ else }}{{ site_name }}{{ /if }}</title>
  <meta name="description" content="{{ description || site_description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  {{ if repo }}
  <link rel="alternate" type="application/rss+xml" title="{{ repo }} · Daily" href="/{{ repo }}/daily.rss">
  <link rel="alternate" type="application/rss+xml" title="{{ repo }} · Weekly" href="/{{ repo }}/weekly.rss">
  <link rel="alternate" type="application/rss+xml" title="{{ repo }} · Monthly" href="/{{ repo }}/monthly.rss">
  {{ /if }}
</head>
<body class="font-sans text-ink antialiased">
  <header class="border-b border-rule">
    <div class="mx-auto max-w-2xl px-6 py-4">
      <a class="text-2xl font-extrabold tracking-tight text-ink no-underline" href="/">{{ site_name }}</a>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-6 py-14">
    {{ content }}
  </main>

  <footer class="border-t border-rule">
    <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-x-2 gap-y-1 px-6 py-10 text-center text-sm text-ink-soft">
      <span>© {{ ("" + new Date().getFullYear()) }} {{ site_name }}</span>
      <span aria-hidden="true">·</span>
      <span>Built with Lume</span>
      <span aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true"><path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path><path d="M4 4a16 16 0 0 1 16 16"></path><path d="M4 11a9 9 0 0 1 9 9"></path></svg>
        RSS on every repo page
      </span>
      <span aria-hidden="true">·</span>
      <span>Next update <span data-next-update>{{ nextUpdate }}</span></span>
    </div>
  </footer>

  <script>
  // Recompute the next 06:00 UTC run on the client so the footer stays correct
  // even on a cached page, and append a relative ("in 3 hours") hint.
  (function () {
    var el = document.querySelector("[data-next-update]");
    if (!el) return;
    var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var now = new Date();
    var next = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 6, 0, 0));
    if (next.getTime() <= now.getTime()) next.setUTCDate(next.getUTCDate() + 1);
    var abs = MONTHS[next.getUTCMonth()] + " " + next.getUTCDate() + ", 06:00 UTC";
    var mins = Math.round((next.getTime() - now.getTime()) / 60000);
    var rel;
    if (mins < 1) rel = "any moment";
    else if (mins < 60) rel = "in " + mins + " min";
    else { var h = Math.round(mins / 60); rel = "in " + h + " hour" + (h === 1 ? "" : "s"); }
    el.textContent = abs + " (" + rel + ")";
  })();
  </script>
</body>
</html>
