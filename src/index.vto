---
layout: layouts/base.vto
---
<div class="repo-list">
  {{ for repo of watched }}
  {{ set posts = search.pages("type=post", "date=desc").filter((p) => p.repo === repo && p.size !== "N") }}
  {{ set latest = posts[0] }}
  <article class="repo-card">
    <header class="repo-card-head">
      <h2 class="repo-card-name"><a href="/{{ repo }}/">{{ repo }}</a></h2>
      <span class="repo-card-count">{{ posts.length }} issue{{ if posts.length != 1 }}s{{ /if }}</span>
    </header>
    {{ if latest }}
    <p class="repo-card-date">
      <time datetime="{{ latest.date |> date('DATETIME') }}">{{ latest.date |> date('HUMAN_DATE') }}</time>
    </p>
    <h3 class="repo-card-title"><a href="{{ latest.url }}">{{ latest.title }}</a></h3>
    {{ if latest.excerpt }}<p class="repo-card-excerpt">{{ latest.excerpt }}</p>{{ /if }}
    <a class="issue-readmore" href="/{{ repo }}/">View all issues →</a>
    {{ else }}
    <p class="repo-card-empty">No issues yet — check back after the next daily run.</p>
    {{ /if }}
  </article>
  {{ /for }}
</div>
